# Isolated capacity-benchmark environment. Local test credentials only;
# NEVER point this at production DB/Redis/Meilisearch endpoints.
# Copy to .env.capacity (gitignored) and run `php artisan key:generate` for
# APP_KEY inside the capacity-app container before first use.
APP_NAME=capacity
APP_ENV=capacity
APP_KEY=
APP_DEBUG=false
APP_URL=https://capacity.test
APP_CONFIG_CACHE=/tmp/capacity-config.php
APP_ROUTES_CACHE=/tmp/capacity-routes.php
APP_EVENTS_CACHE=/tmp/capacity-events.php
APP_SERVICES_CACHE=/tmp/capacity-services.php

LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=capacity-mysql
DB_PORT=3306
DB_DATABASE=capacity
DB_USERNAME=capacity
DB_PASSWORD=capacity_local_only

CACHE_STORE=redis
CACHE_PREFIX=capacity_cache_

QUEUE_CONNECTION=redis
REDIS_HOST=capacity-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_COOKIE=capacity_session

MEILISEARCH_HOST=http://capacity-meilisearch:7700
MEILISEARCH_KEY=capacity_meili_local_only_key
SCOUT_PREFIX=capacity_

VIEW_COMPILED_PATH=/tmp/capacity-views

# Benchmark-only, operator-tuned interval (NOT the 1800/3600s shipped
# default): sized so a ~40000-identity simulated peer pool naturally
# re-announces (with rising counters) roughly once per pool-size/rate
# seconds -- e.g. 40000 peers / 121 announces/s ~= 330s -- which the k6
# swarm scenario relies on via a global, non-sleeping iteration counter
# rather than a manual per-VU sleep.
ANNOUNCE_INTERVAL_MIN=300
ANNOUNCE_INTERVAL_MAX=360

# capacity:status runs via `docker compose exec capacity-app ...`, i.e.
# inside the same container as the web/tracker FPM pools, so the private
# status listeners are reached over loopback, not the service's own name.
CAPACITY_METRICS_ENABLED=true
CAPACITY_FPM_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS=benchmark@capacity.test
MAIL_FROM_NAME=Capacity
DEFAULT_OWNER_EMAIL=benchmark@capacity.test
