APP_NAME=Vltava
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=debug
APP_URL=https://tracker.iamanro.dev
FORCE_ROOT_URL=https://tracker.iamanro.dev
PROXY_SCHEME=https
TRACKER_BIND_ADDRESS=10.0.0.147
APP_DISPLAY_TIMEZONE=Europe/Prague
# Seconds between client announces (upstream default 1800-3600).
ANNOUNCE_INTERVAL_MIN=300
ANNOUNCE_INTERVAL_MAX=360
# Bearer token for GET /health/tracker (PVE healthcheck); empty disables the route.
# Generate with: openssl rand -hex 32
TRACKER_HEALTH_TOKEN=

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unit3d
DB_USERNAME=unit3d
DB_PASSWORD=
# MySQL root credential; must differ from DB_PASSWORD and is never used by the app.
DB_ROOT_PASSWORD=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=tracker.iamanro.dev
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=tracker.iamanro.dev
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS='support@unit3d.site'
MAIL_FROM_NAME='Vltava'

DEFAULT_OWNER_NAME=Vltava
DEFAULT_OWNER_EMAIL=unit3d@example.com
DEFAULT_OWNER_PASSWORD=UNIT3D

TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Local qBittorrent service credential.
QBITTORRENT_PASSWORD=
