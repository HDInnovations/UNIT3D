{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-zend-opcache": "*",
        "ext-zip": "*",
        "assada/laravel-achievements": "^2.8",
        "bjeavons/zxcvbn-php": "^1.4.2",
        "gabrielelana/byte-units": "^0.5.0",
        "graham-campbell/markdown": "^16.1",
        "hdvinnie/laravel-joypixel-emojis": "^3.0.1",
        "hdvinnie/laravel-security-headers": "^3.1.0",
        "intervention/image": "^2.7.2",
        "joypixels/assets": "^v7.0.1",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.24",
        "laravel/octane": "^2.16",
        "laravel/scout": "^10.24",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3.3",
        "maennchen/zipstream-php": "^3.2.1",
        "meilisearch/meilisearch-php": "^1.16.1",
        "spatie/laravel-backup": "^10.0",
        "spatie/ssl-certificate": "^2.6.10",
        "theodorejb/polycast": "dev-master",
        "vstelmakh/url-highlight": "^3.1.3"
    },
    "require-dev": {
        "calebdw/larastan": "^3.12.1",
        "calebdw/larastan-livewire": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.0",
        "jasonmccreary/laravel-test-assertions": "^2.9",
        "laravel/pint": "^1.29.1",
        "laravel/sail": "^1.53",
        "nunomaduro/collision": "^8.8.3",
        "pestphp/pest": "^4.3.2",
        "pestphp/pest-plugin-laravel": "^4.0.0",
        "pestphp/pest-plugin-livewire": "^4.1.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.3",
        "phpstan/phpstan": "^2.2.5",
        "ryoluo/sail-ssl": "^1.4.0",
        "spatie/laravel-ignition": "^2.11",
        "tomasvotruba/bladestan": "^0.11.4",
        "mockery/mockery": "^1.6",
        "laravel/pail": "^1.2.2"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "ext-mcrypt": "1.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=public --provider=\"hdvinnie\\LaravelJoyPixels\\LaravelJoyPixelsServiceProvider\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    }
}
